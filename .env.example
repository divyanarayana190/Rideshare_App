PORT=3001
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# ── Auth (Required in production: min 32 chars, not a placeholder) ────────────
JWT_SECRET=change_me_to_at_least_32_random_characters
ADMIN_JWT_SECRET=change_me_to_a_different_32_char_secret

# ── CORS (Production: Required — comma-separated allowed origins) ─────────────
# Leave empty ONLY in local development — will reject all cross-origin in prod
CORS_ALLOWED_ORIGINS=
OAUTH_SERVER_URL=http://localhost:3001
EXPO_PUBLIC_OAUTH_SERVER_URL=http://localhost:3001
VITE_APP_ID=rideshare-dev

# ── Database (Required in production) ────────────────────────────────────────
DATABASE_URL=mysql://user:password@localhost:3306/yoo_rideshare

# ── Redis (Recommended: OTP, sessions, rate limiting) ─────────────────────────
REDIS_URL=redis://127.0.0.1:6379
# Production (Railway): link Redis plugin → REDIS_URL=${{Redis.REDIS_URL}}

# ── Stripe (Required for real payments) ──────────────────────────────────────
# Get keys from https://dashboard.stripe.com/apikeys
# Use sk_test_ / pk_test_ for testing, sk_live_ / pk_live_ for production
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
EXPO_PUBLIC_STRIPE_MERCHANT_ID=merchant.com.yoo.rideshare

# Webhook secret from https://dashboard.stripe.com/webhooks
# Create endpoint: https://YOUR_DOMAIN/api/webhooks/stripe
# Events: payment_intent.succeeded, payment_intent.payment_failed,
#         setup_intent.succeeded, account.updated, charge.refunded,
#         payment_method.detached
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Platform fee percentage taken from each ride (default: 15)
PLATFORM_FEE_PERCENT=15

# ── Google Maps (Required for route/geocode/places) ───────────────────────────
# Get key from https://console.cloud.google.com — restrict to your server IP in prod
GOOGLE_MAPS_API_KEY=YOUR_SERVER_SIDE_MAPS_KEY_HERE
# Mobile/web client key — restrict to Android package name and iOS bundle ID
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_CLIENT_SIDE_MAPS_KEY_HERE

# ── Google OAuth (Required for Google Sign-In) ────────────────────────────────
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID_IOS=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com

# ── Twilio (Required for SMS OTP and notifications) ───────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Optional Slack webhook used by the advanced seed script
SLACK_OPS_WEBHOOK_URL=

# ── SMTP (Required for student .edu email verification) ───────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_FROM=YOO <noreply@yoo.app>

# ── Sentry (Recommended: crash reporting) ────────────────────────────────────
# Get DSN from https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=https://YOUR_KEY@oXXXXXX.ingest.sentry.io/XXXXXXX
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=yoo-rideshare

# ── Rate Limiting (optional tuning) ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Cloudflare R2 (Required for driver document uploads / file storage) ──────
# Create bucket at https://dash.cloudflare.com → R2
# API tokens: https://dash.cloudflare.com/profile/api-tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=yoo-driver-docs
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# ── DB Pool (optional tuning) ─────────────────────────────────────────────────
DB_POOL_SIZE=20
DB_POOL_IDLE_TIMEOUT=60000
